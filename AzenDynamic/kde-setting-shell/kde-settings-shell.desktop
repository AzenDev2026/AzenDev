[Desktop Entry]
# 这只是模板，供参考。Exec 里的路径是占位符，不会开箱即用。
# 请运行 ./install.sh —— 它会在 ~/.local/share/applications/ 生成
# 一份带正确绝对路径、真正生效的桌面项。
Type=Application
Name=系统设置
Name[en_US]=System Settings
Name[ja_JP]=システム設定
Name[fr_FR]=Paramètres système
Name[de_DE]=Systemeinstellungen
Comment=KDE Settings Shell
Comment[en_US]=KDE Settings Shell
Comment[ja_JP]=KDE 設定シェル
Comment[fr_FR]=KDE Settings Shell
Comment[de_DE]=KDE Settings Shell
Exec=/path/to/kde-setting-shell/launch.sh
Icon=preferences-system
Terminal=false
Categories=Settings;System;Qt;
StartupNotify=true
StartupWMClass=KDE Settings Shell
